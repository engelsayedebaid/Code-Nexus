{
  "name": "code-nexus",
  "version": "1.4.257",
  "description": "AI-Powered Development Environment",
  "homepage": "https://github.com/stablyai/orca",
  "author": "stablyai",
  "bin": {
    "code-nexus": "./out/cli/index.js",
    "code-nexus-dev": "./config/scripts/development/launch/orca-dev.mjs"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node config/scripts/development/launch/run-electron-vite-dev.mjs",
    "dev:fresh": "node config/scripts/development/profile-seeding/dev-fresh-profile.mjs",
    "dev:seed-profile": "node config/scripts/development/profile-seeding/dev-profile-seed.mjs",
    "build": "pnpm run build:packages && pnpm run build:desktop && pnpm run build:cli",
    "build:packages": "node config/scripts/workspace-package-build/build-workspace-packages.mjs",
    "build:electron-vite": "node config/scripts/desktop-build/execution/run-electron-vite-build.mjs",
    "build:web": "node config/scripts/web-build/execution/run-vite-web-build.mjs && node config/scripts/web-build/execution/verify-web-build.mjs",
    "build:web-from-renderer": "node config/scripts/development/web-client/project-renderer-web-client.mjs",
    "build:mobile-web": "node config/scripts/build/mobile-web-app/build-mobile-web-app-bundle.mjs",
    "build:desktop": "pnpm run build:electron-vite && pnpm run build:web-from-renderer && pnpm run build:mobile-web",
    "build:cli": "node config/scripts/cli-build/build-cli.mjs",
    "tc": "node config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs",
    "tc:node": "node config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs --project=config/tsconfig.node.json",
    "tc:web": "node config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs --project=config/tsconfig.tc.web.json",
    "tc:cli": "node config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs --project=config/tsconfig.tc.cli.json",
    "tc:e2e": "node config/scripts/typecheck/e2e-admission/run-e2e-typecheck.mjs",
    "typecheck": "pnpm run tc && pnpm run tc:e2e",
    "typecheck:ci": "node config/scripts/typecheck/project-execution/run-typecheck-projects-in-parallel.mjs --compiler=bun",
    "test": "node config/scripts/test-runtime/execution-policy/run-vitest.mjs run --config config/vitest.config.ts",
    "test:changed": "node config/scripts/test-runtime/execution-policy/run-vitest.mjs run --config config/vitest.config.ts --changed",
    "vitest": "node config/scripts/test-runtime/execution-policy/run-vitest.mjs",
    "lint": "node config/scripts/preflight/changed-checks/run-lint.mjs",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "generate:rpc-params-catalog": "node config/scripts/plugin-authoring/rpc-catalog/generate-rpc-params-catalog.mjs",
    "verify:rpc-params-catalog": "node config/scripts/plugin-authoring/rpc-catalog/generate-rpc-params-catalog.mjs --check",
    "check:changed": "node config/scripts/preflight/changed-checks/check-changed.mjs",
    "check:code-quality:changed": "node config/scripts/preflight/changed-checks/check-changed-code-quality.mjs",
    "check:import-boundaries": "node config/scripts/static-analysis/process-boundaries/check-import-boundaries.mjs",
    "verify:localization-extraction": "node config/scripts/localization/source-extraction/verify-localization-extraction.mjs",
    "audit:anti-slop": "node config/scripts/static-analysis/oxlint-contracts/sync-anti-slop-plugin.mjs && oxlint --config config/oxlint-anti-slop.json src config tests mobile --deny-warnings",
    "audit:code-quality:type-aware": "oxlint --type-aware --config config/oxlint-code-quality-type-aware.json src config tests --deny-warnings",
    "audit:code-quality:native": "oxlint --config config/oxlint-code-quality-native-plugins.json src config tests mobile --deny-warnings",
    "check:test-file-runners": "node config/scripts/ci/unit-selection/check-test-file-runners.mjs",
    "verify:localization-catalogs": "node config/scripts/localization/catalog-validation/verify-localization-catalogs.mjs",
    "verify:localization-coverage": "node config/scripts/localization/source-extraction/audit-localization-coverage.mjs",
    "verify:mobile-localization": "node config/scripts/localization/catalog-validation/verify-mobile-localization.mjs",
    "lint:ast-grep-gates": "node config/scripts/static-analysis/structural-scan/ast-grep-gates.mjs",
    "lint:js-plugins": "oxlint --config config/oxlint-js-plugins.json src config tests mobile native .github",
    "check:dead-classes": "oxlint --config config/oxlint-dead-classes.json src/renderer",
    "check:main-sync-spawn-ratchet": "node config/scripts/static-analysis/process-boundaries/check-main-sync-spawn-ratchet.mjs",
    "check:has-restyle-scope": "node config/scripts/static-analysis/renderer-styles/check-has-restyle-scope.mjs",
    "check:layout-writer-ratchets": "node config/scripts/static-analysis/ratchets/renderer-state/check-layout-writer-ratchets.mjs",
    "check:e2e-typecheck-ratchet": "node config/scripts/typecheck/e2e-admission/check-e2e-typecheck-ratchet.mjs",
    "check:focus-read-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-focus-read-ratchet.mjs",
    "check:legacy-relay-fence-ratchet": "node config/scripts/static-analysis/process-boundaries/check-legacy-relay-fence-ratchet.mjs",
    "check:runtime-electron-ratchet": "node config/scripts/static-analysis/process-boundaries/check-runtime-electron-ratchet.mjs",
    "check:repo-host-read-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-repo-host-read-ratchet.mjs",
    "check:max-lines-ratchet": "node config/scripts/static-analysis/ratchets/source-budget/check-max-lines-ratchet.mjs",
    "check:mobile-shared-dependency-versions": "node config/scripts/package-manager/lockfile-contracts/check-mobile-shared-dependency-versions.mjs",
    "check:ts-nocheck-ratchet": "node config/scripts/static-analysis/ratchets/source-budget/check-ts-nocheck-ratchet.mjs",
    "check:workspace-record-read-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-workspace-record-read-ratchet.mjs",
    "check:tab-map-seam-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-tab-map-seam-ratchet.mjs",
    "check:terminal-parking-ownership-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-terminal-parking-ownership-ratchet.mjs",
    "check:unproven-pty-retirement-ratchet": "node config/scripts/static-analysis/ratchets/runtime-lifecycle/check-unproven-pty-retirement-ratchet.mjs",
    "check:daemon-blocking-call-ratchet": "node config/scripts/static-analysis/ratchets/runtime-lifecycle/check-daemon-blocking-call-ratchet.mjs",
    "check:main-sync-fs-ratchet": "node config/scripts/static-analysis/ratchets/runtime-lifecycle/check-main-sync-fs-ratchet.mjs",
    "check:recurring-timer-ratchet": "node config/scripts/static-analysis/ratchets/runtime-lifecycle/check-recurring-timer-ratchet.mjs",
    "check:node-runtime-pin": "node config/scripts/node-runtime/pin-policy/check-node-runtime-pin.mjs",
    "check:path-literal-ratchet": "node config/scripts/static-analysis/ratchets/source-budget/check-path-literal-ratchet.mjs",
    "check:host-list-render-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-host-list-render-ratchet.mjs",
    "check:id-only-store-write-ratchet": "node config/scripts/static-analysis/ratchets/renderer-state/check-id-only-store-write-ratchet.mjs",
    "check:flaky-test-pattern-ratchet": "node config/scripts/static-analysis/ratchets/test-quality/check-flaky-test-pattern-ratchet.mjs",
    "verify:skill-bundle-manifest": "node config/scripts/skills/bundle-generation/generate-skill-bundle-manifest.mjs --check",
    "check:reliability-gates": "node config/scripts/static-analysis/reliability-policy/check-reliability-gates.mjs",
    "verify:bundled-skill-guides": "node config/scripts/skills/bundle-generation/generate-bundled-skill-guides.mjs --check",
    "verify:plugin-authoring-skill-references": "node config/scripts/skills/bundle-generation/generate-plugin-authoring-skill-references.mjs --check",
    "check:readme-local-links": "node config/scripts/static-analysis/repository-layout/check-readme-local-links.mjs",
    "verify:acp-protocol": "node config/scripts/acp/generate-protocol.mjs --check"
  },
